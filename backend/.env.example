# 知乎开放平台密钥。请复制为 .env 后填写，不要提交真实密钥。
ZHIHU_ACCESS_SECRET=

# OpenAI-compatible API。Base URL 示例通常以 /v1 结尾，按服务商文档填写。
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=deepseek-flash

# 允许访问后端的前端地址，多个地址使用英文逗号分隔。
# 本地默认地址已由代码包含；部署后填写前端的 HTTPS 地址。
FRONTEND_ORIGINS=

# 知乎 OAuth。拿到官方凭证后填写；SESSION_SECRET 请使用随机长字符串。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/zhihu/callback
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=
